# Flask
FLASK_APP=app.py
FLASK_ENV=development
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-48-byte-random-string-see-command-above

# Postgres (local Docker container)
POSTGRES_USER=snapense_user
POSTGRES_PASSWORD=snapense_pass
POSTGRES_DB=snapense_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Overrides the parts above when set:
# DATABASE_URL=postgresql+psycopg://snapense_user:snapense_pass@localhost:5432/snapense_db

# JWT
JWT_SECRET_KEY=replace-with-a-different-48-byte-random-string
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# Uploads
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=10

# Storage backend for receipt images: "local" (default, saves to
# UPLOAD_FOLDER -- fine for dev, but lost on redeploy on hosts with an
# ephemeral filesystem like Render) or "s3" (Supabase Storage, via its
# S3-compatible API). The SUPABASE_S3_* vars below are only read when
# STORAGE_PROVIDER=s3.
STORAGE_PROVIDER=local

# Supabase Storage (S3-compatible) -- Project Settings > Storage > S3 Connection
# in the Supabase dashboard.
# The S3-compatible endpoint URL, e.g. https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=
# The region shown alongside the endpoint, e.g. us-east-1
SUPABASE_S3_REGION=
# Access key ID for an S3 access key created under Storage > S3 Connection
SUPABASE_S3_ACCESS_KEY_ID=
# Secret access key paired with the access key ID above
SUPABASE_S3_SECRET_ACCESS_KEY=
# Name of the (private) Supabase Storage bucket receipts are uploaded to
SUPABASE_STORAGE_BUCKET=

# Vision LLM (receipt OCR)
# Get a free key at https://aistudio.google.com/apikey - sign in with a Google
# account, click "Create API key", and paste the value below. No credit card
# is required; gemini-2.5-flash has a free tier.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048

# Anomaly detection
ANOMALY_ZSCORE_THRESHOLD=2.5
ANOMALY_MIN_HISTORY=5

# CORS
CORS_ORIGINS=*
